{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=workpulse;Username=workpulse;Password=workpulse",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "Issuer": "WorkPulse",
    "Audience": "WorkPulse",
    "SecretKey": "CHANGE_ME_USE_A_STRONG_SECRET_KEY_IN_PRODUCTION_MIN_32_CHARS",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    }
  }
}
